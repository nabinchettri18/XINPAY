# Supabase Auth / Data API. Use the project URL and publishable key only.
# These VITE_ values are public by design; never use a Supabase secret/service_role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional override for the hosted XinPay Worker API.
VITE_API_BASE_URL=https://xinpay.nabinchettri0007.workers.dev
