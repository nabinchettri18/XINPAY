# Browser-safe Supabase Auth configuration (publishable key only).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Vercel Function runtime configuration. Keep these server-side values unprefixed.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Payments remain off unless explicitly enabled for a reviewed sandbox test.
PAYMENTS_ENABLED=false
DIRECT_UPI_ENABLED=false
CASHFREE_ENV=sandbox

# Set only as encrypted Vercel environment variables when enabling Cashfree sandbox.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=

# Required only for Cashfree webhook persistence (never expose to VITE_ or client-side code).
SUPABASE_SECRET_KEY=
PUBLIC_BASE_URL=https://YOUR_VERCEL_DOMAIN
